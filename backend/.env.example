# Copy to .env (gitignored) and fill in. Variables already set in the
# environment take precedence over this file.

# HTTP port the backend listens on.
PORT=8080

# PostgreSQL connection. DB_HOST, DB_USER and DB_NAME are required.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=require
